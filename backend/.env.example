ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://pinesphere:pinesphere@localhost:5432/pinesphere
REDIS_URL=redis://localhost:6379/0
# generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=["http://localhost:5173"]

# WhatsApp
ENABLE_SIMULATOR=true
# must match the "Verify token" you type in the Meta app's webhook settings
WHATSAPP_VERIFY_TOKEN=pinesphere-verify
# Meta app -> App settings -> Basic -> App secret (or save it per company in Settings -> WhatsApp)
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
MEDIA_ROOT=media

# AI order capture (M5). mock = built-in parser for development (no key, typed orders only).
# For real AI set AI_PROVIDER=anthropic or openai and paste the company's API key.
AI_PROVIDER=mock
AI_API_KEY=
# optional model overrides (blank = defaults: anthropic claude-haiku-5-5 / claude-sonnet-5-5, openai gpt-5.4-mini / gpt-5.4)
AI_MODEL_FAST=
AI_MODEL_SMART=
# voice notes: none | openai (uses STT_API_KEY, or AI_API_KEY when AI_PROVIDER=openai)
STT_PROVIDER=none
STT_API_KEY=

# true = run background jobs inline (no Redis/worker needed). Set false in production and run the worker.
CELERY_EAGER=true
